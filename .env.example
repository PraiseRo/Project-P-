# ==========================================
# Local AI Assistant Configuration
# ==========================================

# AI Provider Settings ("openai", "gemini", "ollama")
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# Speech-to-Text (STT) Settings ("openai_whisper", "faster_whisper")
STT_PROVIDER=openai_whisper
STT_MODEL=whisper-1
STT_LANGUAGE=en

# Text-to-Speech (TTS) Settings ("edge_tts", "pyttsx3")
TTS_PROVIDER=edge_tts
TTS_VOICE=en-US-ChristopherNeural
TTS_RATE=0%
TTS_VOLUME=100%

# Voice & Input Hotkeys
PUSH_TO_TALK_KEY=ctrl+space
EMERGENCY_STOP_KEY=ctrl+alt+esc
AUDIO_SAMPLE_RATE=16000
SILENCE_TIMEOUT_SECONDS=1.5
MAX_RECORDING_SECONDS=30.0

# Security & Permissions
DEFAULT_PERMISSION_LEVEL=1
REQUIRE_CONFIRMATION_FOR_RISKY=true

# UI Settings
MINIMIZE_TO_TRAY=true
DARK_MODE=true
