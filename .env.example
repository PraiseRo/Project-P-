# ==========================================
# Project P Configuration
# ==========================================

# Speech-to-Text (STT) Settings ("free", "openai_whisper")
# "free" uses the unlimited built-in speech recognizer with ZERO API keys or quota limits!
STT_PROVIDER=free
STT_LANGUAGE=en

# Text-to-Speech (TTS) Settings ("edge_tts", "pyttsx3")
TTS_PROVIDER=edge_tts
TTS_VOICE=en-US-ChristopherNeural

# Voice & Input Hotkeys
PUSH_TO_TALK_KEY=ctrl+space
EMERGENCY_STOP_KEY=ctrl+alt+esc

# (Optional) Cloud AI Settings (for complex online chat)
AI_PROVIDER=hybrid
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
GEMINI_API_KEY=
